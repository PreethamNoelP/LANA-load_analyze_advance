# ─────────────────────────────────────────────────────────────────────────────
# LANA Environment Configuration
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Choose: "ollama"  or  "openai_compat"
LLM_PROVIDER=ollama

# Model name used by the selected provider
# Ollama examples    : llama3.1:8b | mistral:7b | phi3:mini | gemma2:2b | qwen2.5:7b
# OpenAI-compat ex.  : llama-3.1-8b-instant (Groq) | llama-3-8b (Together.ai)
LLM_MODEL=llama3.1:8b

# Generation parameters
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

# Request timeout in seconds — a hung provider fails after this instead of blocking forever
LLM_TIMEOUT=90

# ── Ollama ────────────────────────────────────────────────────────────────────
# URL where Ollama is running (default: http://localhost:11434)
OLLAMA_HOST=http://localhost:11434

# Context window (tokens) of the model you are using. Ollama's own default
# (2048-4096) is too small once a dataset's column stats are added to the
# prompt — raise this if you upload very wide datasets and the AI seems to
# "forget" columns.
#
# This is not Ollama-only. LANA also uses it to decide how much context to
# build, for every provider, so if you point LANA at a hosted model with a
# large window (see the OpenAI-compatible section below) raise this to match
# or LANA will trim facts it did not need to trim.
LLM_NUM_CTX=8192

# ── OpenAI-compatible API (Groq, LM Studio, Together.ai, Fireworks, etc.) ─────
# OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_COMPAT_API_KEY=gsk_...
# LLM_PROVIDER=openai_compat
# LLM_MODEL=llama-3.1-8b-instant

# ── Backend API ───────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call the API (CORS).
# Defaults to the two local dev servers below if unset. Cannot contain "*" —
# the API is served with credentials enabled, and browsers reject a wildcard
# origin combined with credentials.
# LANA_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Max LLM requests (Ask AI) that run at once. A local Ollama model serves
# requests one at a time well — a burst of concurrent visitors beyond this
# gets a "busy, try again" response instead of all queuing and timing out.
# LANA_MAX_CONCURRENT_LLM=2

# ── Memory limits (auto-detected — override only if you need to) ──────────────
# LANA sizes these from your machine's installed RAM at startup, so the same
# settings work on an 8 GB laptop and a 64 GB workstation. Check what it chose
# for your machine at GET /health, under "limits".
#
#   max_session_mb  25% of installed RAM — total size of all loaded datasets
#   max_upload_mb   the above / 6 — one file, because parsing a file transiently
#                   needs several times its size in memory
#
# Setting either of these explicitly overrides the detection. Raise them if you
# have headroom and want to work with bigger files; lower them if you want LANA
# to leave more room for everything else you have open.
# LANA_MAX_UPLOAD_MB=512
# LANA_MAX_SESSION_MB=4096

# Datasets held at once, and how long an idle one is kept before being dropped.
# LANA_MAX_SESSIONS=30
# LANA_SESSION_TTL_SECONDS=3600

# ── Persistence ───────────────────────────────────────────────────────────────
# Off by default: sessions live in memory only and a restart loses them, same
# as LANA has always behaved. Set to true so sessions survive a restart —
# each is mirrored to a SQLite index + Parquet files under LANA_DATA_DIR. The
# Docker image (docker-compose.yml) sets this to true with a named volume.
# LANA_PERSIST_SESSIONS=false
# LANA_DATA_DIR=data

# ── Auth ──────────────────────────────────────────────────────────────────────
# Empty by default: every endpoint is open, as LANA has always assumed for a
# single local user. Set this to require `Authorization: Bearer <token>` on
# every request except /health — do this if LANA will be reachable by more
# than just you (a home server, a shared machine on your LAN). This is a
# single shared secret, not a login system: anyone with the token has full
# access, and there is no concept of separate users.
# Generate one with, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
# LANA_AUTH_TOKEN=


# ─────────────────────────────────────────────────────────────────────────────
# Executed-SQL grounding
# ─────────────────────────────────────────────────────────────────────────────
# When on (the default), a question is first answered by generating a SQL
# query and running it against your data in a sandboxed DuckDB, so the figures
# are computed from the rows rather than retrieved from a precomputed summary.
# If planning fails, LANA falls back to the fact ledger automatically.
#
# The sandbox has no filesystem and no network access, only SELECTs are
# accepted, and the configuration is locked so a generated query cannot turn
# any of that back on. See app/analysis/sql_engine.py.
# LANA_SQL_GROUNDING=true

# ─────────────────────────────────────────────────────────────────────────────
# Rate limiting
# ─────────────────────────────────────────────────────────────────────────────
# Token bucket per caller. `capacity` is the burst allowed at once,
# `refill_per_second` the sustained rate. The defaults are far above what one
# person generates and exist to bound a runaway script, not to pace you.
# LANA_RATE_CAPACITY=120
# LANA_RATE_REFILL_PER_SECOND=2.0
#
# Questions cost seconds of local inference rather than milliseconds of pandas,
# so they have their own bucket: a burst of 20, then 30 a minute sustained.
# LANA_LLM_RATE_CAPACITY=20
# LANA_LLM_RATE_REFILL_PER_SECOND=0.5

# ─────────────────────────────────────────────────────────────────────────────
# Multi-worker coordination
# ─────────────────────────────────────────────────────────────────────────────
# "auto" (default) uses SQLite when session persistence is on, and in-process
# state otherwise. SQLite is what lets several uvicorn workers on one shared
# volume enforce ONE concurrency cap and ONE rate limit between them, instead
# of one each.
#
# This coordinates workers sharing a filesystem. It is not a distributed lock
# service; LANA does not support replicas spread across separate hosts.
# LANA_COORDINATION=auto        # auto | memory | sqlite

# ─────────────────────────────────────────────────────────────────────────────
# Observability
# ─────────────────────────────────────────────────────────────────────────────
# "plain" is readable in a terminal; "json" emits one JSON object per line for
# a log shipper, with the request id attached to every record.
# LANA_LOG_FORMAT=plain         # plain | json
# LANA_LOG_LEVEL=INFO
#
# Prometheus metrics are always served at GET /metrics. Counts and latencies
# only — never a column name, a value or a filename.
#
# The audit trail is separate from the log and answers a different question:
# not "why was yesterday slow" but "who loaded, cleaned, questioned or exported
# which dataset, and when". It records only those actions plus refused access
# and failed authentication — never cell values, column names or the token.
#
# Off unless there is somewhere durable to put it: on automatically when
# LANA_PERSIST_SESSIONS is true (written to <LANA_DATA_DIR>/audit.jsonl), or
# set this to a path to turn it on anywhere. Rotated at 8 MB, 3 files kept.
# Read your own entries at GET /audit.
# LANA_AUDIT_LOG=/var/log/lana/audit.jsonl

# ─────────────────────────────────────────────────────────────────────────────
# Data source connectors
# ─────────────────────────────────────────────────────────────────────────────
# Rows a single connector load may pull. The equivalent of the upload cap for
# databases and APIs, which have no natural size limit of their own.
# LANA_MAX_SOURCE_ROWS=200000
#
# URL sources refuse private, loopback and cloud-metadata addresses by default.
# That is what stops "analyse the data at this URL" from becoming a request
# forgery against your own network — most sharply
# http://169.254.169.254/, which on a cloud host returns credentials.
#
# Set this only to point LANA at an internal API on purpose, and only when you
# trust everyone who can reach LANA to supply URLs.
# LANA_ALLOW_PRIVATE_SOURCE_URLS=false
#
# Directories the `file` connector may read from, comma-separated. This one is
# about *whose* disk: the connector reads a path on the machine running LANA,
# which on your own laptop is the feature and on a shared instance is a way for
# anyone who can reach LANA to read any CSV or JSON on the host.
#
# Leave it unset for a single-user local install — unrestricted, as before.
# When LANA_AUTH_TOKEN is set (i.e. more than one person can reach this
# instance) the connector is disabled until you name the directories it may
# read. Paths are resolved first, so `..` and symlinks cannot escape a root.
# Uploading a file is never affected.
# LANA_FILE_SOURCE_ROOTS=/srv/datasets,/mnt/exports

# How long a browser stays signed in after exchanging LANA_AUTH_TOKEN for a
# cookie at POST /auth/session. The token is no longer compiled into the
# frontend bundle; the cookie is HttpOnly, so page scripts cannot read it.
# LANA_AUTH_COOKIE_MAX_AGE=43200
